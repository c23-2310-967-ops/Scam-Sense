# Unity generated folders (rebuilt automatically - never commit)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# IDE / OS files
.vs/
.vscode/
.idea/
*.csproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.DS_Store
Thumbs.db
Desktop.ini
*.tmp
*.swp
~$*

# Blender backup files (the .blend / .obj / .fbx sources themselves are kept)
*.blend1
*.blend2

# Unity crash and memory logs
sysinfo.txt
mono_crash.*

# Secrets and local environment files
.env
.env.*
!.env.example
*.pem

# Build artifacts
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# Local safety copies made while editing (remove this line if you want them on GitHub)
/Backups/

# Local AI-assistant / editor-tool configuration (not part of the game)
/.claude/
/GeneratedAssets/

# Supabase connection settings (project URL + publishable key) - stay on this PC, never committed
/Assets/Resources/SupabaseSettings.json
/Assets/Resources/SupabaseSettings.json.meta

# Test reports (written by Tools > Scam Sense > Run All Tests and Assets/Tests/run-tests.ps1)
/[Tt]est[Rr]esults/
