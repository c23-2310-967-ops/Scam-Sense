  caseFiles:
  - title: Case Notes
    body: "\u2022 While browsing, a full-screen red page appeared and started beeping.\n\u2022
      One minute before this email arrived, you clicked \"Forgot password\" on NovaCloud
      yourself. Trusted domain (case files): novacloud.example"
  - title: How This Room Works
    body: '1. 6 questions arrive one at a time, in a new order each attempt.


      2.
      Case questions: pick the safest, most accurate answer (A-D).


      3. Messages
      and web pages: choose SCAM or LEGITIMATE.


      4. Not sure? Press HINT to
      see what to look at. After each answer you''ll see why it was right or wrong.


      Goal:
      score 450+ to unlock the next room.'
  firstMessageDelay: 8
  delayBetweenMessages: {x: 10, y: 20}
  minimumActivityDelay: 4
  scoring:
    basePoints: 150
    speedBonus: 0
    fastWindow: 0.35
    wrongPenalty: 15
    recoveryPoints: 38
