    link: 
    correctVerdict: 0
    scenarioContext: 
    explanation: 
    trigger: 0
    readingSeconds: 0
    stationId: 
    requestedAction: 
    linkNote: 
    clues: []
    inspectables: []
    evidence: []
    consequence:
      kind: 0
      alertTitle: 
      alertBody: 
      overlookedClue: 
      followUp: 0
      recheckDetails: []
    choices: []
    correctChoice: 0
    feedback: 
    curriculumRef: 
