%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 147873241f4f7964690daffb230f2761, type: 3}
  m_Name: Level1_TheFirstCase
  m_EditorClassIdentifier: 
  levelId: level_1
  levelNumber: 1
  displayName: The First Case
  sceneName: Game
  description: A fake delivery text, a phishing email, and two real emails that are
    safe.
  previewImage: {fileID: 21300000, guid: 3c2461ec3d7cb3f4195d1800bbe3a169, type: 3}
  briefingTitle: WELCOME, INVESTIGATOR
  briefingText: 'You just joined the Cybercrime Investigation Unit. Your job: catch
    fake texts, emails and posts before they steal money, passwords or personal details.


    This
    is your training case. A guide will walk you through your first question.'
  caseNotes:
  - You have not ordered anything this month.
  - You reserved a book at Riverside Public Library on Monday.
  - You signed up for Saturday's park clean-up. Sam is the volunteer team's organiser.
  objectives:
  - Follow the guide on your first question.
  - Answer all 4 questions.
  - Score 230+ to unlock the next room.
  messages:
  - id: E02
    channel: 0
    sender: +63 917 555 0142
    senderDetail: 
    subject: 
    body: "SwiftParcel: Your package is ON HOLD due to an incomplete address. Pay
      the \u20B129 redelivery fee within 12 hours or it will be returned:"
    link: http://swiftparcel-redeliver.example/pay
    correctVerdict: 0
    scenarioContext: You have not ordered anything this month.
    explanation: You didn't order anything, so there is no package. The text comes
      from a random mobile number, rushes you with a 12-hour deadline, and links
      to a site that isn't the courier's. The small fee is bait to get your card
      or e-wallet details.
    trigger: 3
    readingSeconds: 0
    stationId: 
    requestedAction: 
    linkNote: 
    clues: []
    inspectables:
    - id: sender
      field: 0
      match: 
      label: Sender
      finding: An ordinary mobile number, not a named courier. Real delivery companies
        text from their own name or a short code.
      linkAddress: 
      clueId: number
      part: 
    - id: claim
      field: 3
      match: Your package is ON HOLD
      label: The claim
      finding: Your case notes say you haven't ordered anything this month - so which
        package?
      linkAddress: 
      clueId: noorder
      part: 
    - id: fee
      field: 3
      match: "Pay the \u20B129 redelivery fee"
      label: The request
      finding: 'A small fee is bait: the real goal is your card or e-wallet details.'
      linkAddress: 
      clueId: fee
      part: 
    - id: deadline
      field: 3
      match: within 12 hours
      label: Deadline
      finding: A short deadline pushes you to act before you think.
      linkAddress: 
      clueId: urgent
      part: 
    - id: link
      field: 4
      match: 
      label: Link
      finding: swiftparcel-redeliver.example is not an official courier site, and
        it starts with http (not secure).
      linkAddress: http://swiftparcel-redeliver.example/pay
      clueId: link
      part: 
    evidence:
    - id: number
      title: Ordinary mobile number
      whyItMatters: Couriers don't text from random mobile numbers.
      supportsVerdict: 1
    - id: noorder
      title: No order to deliver
      whyItMatters: You haven't ordered anything, so there is no real package.
      supportsVerdict: 1
    - id: fee
      title: Asks for a payment
      whyItMatters: Small fees are used to steal card and e-wallet details.
      supportsVerdict: 1
    - id: urgent
      title: Pressure to act fast
      whyItMatters: Scams rush you so you don't stop to check.
      supportsVerdict: 1
    - id: link
      title: Unofficial, insecure link
      whyItMatters: The link isn't the courier's site and isn't secure.
      supportsVerdict: 1
    consequence:
      kind: 0
      alertTitle: 
      alertBody: 
      overlookedClue: 
      followUp: 0
      recheckDetails: []
    choices: []
    correctChoice: 0
    feedback: Scam! No order + a small fee + a rush deadline = a fake delivery text.
      Don't tap the link.
    curriculumRef: "Information Assurance in Security 1 (BIT1101) \u2014 Week 16:
      Information Security Best Practices (user awareness)"
    hint: 'Compare the text with your case notes: were you expecting a package? Then
      check who sent it and where the link goes.'
    activity:
      kind: 0
      title: 
      instruction: 
      items: []
      minClues: 1
      outcomes: []
  - id: E03
    channel: 5
    sender: Case Review
    senderDetail: 
    subject: Identify the Threat
    body: '<b>Email from:</b> Campus IT Helpdesk <noparse><</noparse>helpdesk@uphs1-binan.example<noparse>></noparse>

      <b>Subject:</b>
      Mailbox 98% full: verify now

      "Your school mailbox will be DELETED in
      24 hours. Click below and sign in to verify your account." <b>What kind of
      threat is this?</b>'
    link: 
    correctVerdict: 0
    scenarioContext: 
    explanation: <b>Phishing</b> is a fake message that tricks you into giving away
      your password. This one copies the school (<b>uphs1</b> uses the number 1,
      not the letter l), scares you with a deadline and asks you to sign in. Real
      storage warnings never ask for your password.
    trigger: 0
    readingSeconds: 0
    stationId: 
    requestedAction: 
    linkNote: 
    clues: []
    inspectables:
    - id: address
      field: 5
      match: uphs1-binan.example
      label: Sender address
      finding: 'Look closely: uphs1 uses the number 1 instead of the letter l. It''s
        a lookalike of the school''s real domain.'
      linkAddress: 
      clueId: lookalike
      part: from
    - id: subject
      field: 5
      match: Mailbox 98% full
      label: Subject
      finding: Full mailboxes really happen. On its own this isn't a warning sign
        - look at what the email asks you to do.
      linkAddress: 
      clueId: 
      part: subject
    - id: deadline
      field: 5
      match: DELETED in 24 hours
      label: Threat
      finding: A scary deadline pushes you to act fast without checking.
      linkAddress: 
      clueId: urgent
      part: body
    - id: request
      field: 5
      match: sign in to verify your account
      label: What it asks
      finding: It wants your password through a link. Real IT staff never ask you
        to 'verify' your password by email.
      linkAddress: 
      clueId: creds
      part: body
    - id: button
      field: 5
      match: VERIFY MY ACCOUNT
      label: The button
      finding: 'It leads to a sign-in page from an email link - the way fake pages
        collect passwords. (Simulated: nothing opens.)'
      linkAddress: 
      clueId: creds
      part: button
    evidence:
    - id: lookalike
      title: Lookalike sender domain
      whyItMatters: uphs1 is not uphsl - a fake address made to look real.
      supportsVerdict: 1
    - id: urgent
      title: Scary deadline
      whyItMatters: Threats and short deadlines are pressure tactics.
      supportsVerdict: 1
    - id: creds
      title: Asks you to sign in through a link
      whyItMatters: That's how fake pages collect passwords.
      supportsVerdict: 1
    consequence:
      kind: 4
      alertTitle: 
      alertBody: 
      overlookedClue: 
      followUp: 1
      recheckDetails: []
    choices:
    - Phishing
    - Ransomware
    - Denial-of-service attack
    - A normal storage warning
    correctChoice: 0
    feedback: 'Phishing! Look closely: <b>uphs1</b>, not uphsl. Fake sender + scary
      deadline + "sign in here" = phishing.'
    curriculumRef: "Computer Security (BIT1225) \u2014 Introduction to Computer Security:
      \"types of security threats\u2026 in both personal and organizational contexts\""
    hint: Check the sender's address letter by letter, then ask yourself what the
      email wants you to do.
    activity:
      kind: 1
      title: "Campus Mail  \xB7  Inbox"
      instruction: 'Check the email: who sent it, the subject, and what it asks you
        to do.'
      items:
      - key: from
        role: 0
        label: From
        text: Campus IT Helpdesk <helpdesk@uphs1-binan.example>
      - key: subject
        role: 0
        label: Subject
        text: 'Mailbox 98% full: verify now'
      - key: body
        role: 1
        label: 
        text: Your school mailbox will be DELETED in 24 hours. Click below and sign
          in to verify your account.
      - key: button
        role: 7
        label: 
        text: VERIFY MY ACCOUNT
      minClues: 0
      outcomes: []
  - id: L01
    channel: 1
    sender: Riverside Public Library
    senderDetail: notices@riversidelibrary.example
    subject: Your reserved book is ready for pickup
    body: The book you reserved is now available at the front desk. It will be held
      for 7 days. Log in to your library account if you need more time.
    link: 
    correctVerdict: 1
    scenarioContext: You reserved a book at Riverside Public Library on Monday.
    explanation: You reserved a book this week, so this email is expected. It comes
      from the library's own address, gives you 7 days, and only asks you to pick
      the book up at the front desk. It doesn't ask for a password, money or a code,
      and there's no link to click.
    trigger: 2
    readingSeconds: 0
    stationId: 
    requestedAction: 
    linkNote: 
    clues: []
    inspectables:
    - id: sender
      field: 1
      match: 
      label: Sender address
      finding: 'The address ends in the library''s own name: riversidelibrary.example.'
      linkAddress: 
      clueId: sender
      part: 
    - id: claim
      field: 3
      match: The book you reserved is now available
      label: The news
      finding: Your case notes say you reserved a book this week. This is exactly
        what you were waiting for.
      linkAddress: 
      clueId: expected
      part: 
    - id: pickup
      field: 3
      match: at the front desk
      label: What it asks
      finding: You pick the book up in person. No link, no payment, no password.
      linkAddress: 
      clueId: noask
      part: 
    - id: login
      field: 3
      match: Log in to your library account
      label: Account
      finding: It tells you to use your own account if you need more time. It doesn't
        send you a login link.
      linkAddress: 
      clueId: noask
      part: 
    - id: time
      field: 3
      match: held for 7 days
      label: Time
      finding: Seven days is plenty of time. Nothing pushes you to act right now.
      linkAddress: 
      clueId: calm
      part: 
    evidence:
    - id: sender
      title: The library's own address
      whyItMatters: The sender matches the library you used.
      supportsVerdict: 1
    - id: expected
      title: You were expecting it
      whyItMatters: You reserved a book, so this news makes sense.
      supportsVerdict: 1
    - id: noask
      title: Asks for nothing secret
      whyItMatters: No link, money, password or code is requested.
      supportsVerdict: 1
    - id: calm
      title: No pressure
      whyItMatters: Real notices give you time instead of rushing you.
      supportsVerdict: 1
    consequence:
      kind: 0
      alertTitle: 
      alertBody: 
      overlookedClue: 
      followUp: 0
      recheckDetails: []
    choices: []
    correctChoice: 0
    feedback: Legitimate! It matches what you did, there's no rush, and it asks for
      nothing secret.
    curriculumRef: "Information Assurance in Security 1 (BIT1101) \u2014 Week 16:
      Information Security Best Practices (user awareness)"
    hint: 'Check your case notes: did you do something that explains this email?
      Then look at what it asks you to do.'
    activity:
      kind: 0
      title: 
      instruction: 
      items: []
      minClues: 1
      outcomes: []
  - id: L02
    channel: 1
    sender: Sam (Volunteer Team)
    senderDetail: sam@greenparkvolunteers.example
    subject: 'Saturday clean-up: meeting point'
    body: Hi everyone, we'll meet at the park entrance at 9:00 on Saturday. Bring
      gloves and water. See you there!
    link: 
    correctVerdict: 1
    scenarioContext: You signed up for Saturday's park clean-up. Sam is the volunteer
      team's organiser.
    explanation: 'You signed up for this clean-up, and Sam is the organiser. The
      email only gives the meeting time and place and what to bring. There is no
      link, no payment, no password and no pressure. Not every message is a scam:
      real ones match what you expect and ask for nothing risky.'
    trigger: 2
    readingSeconds: 0
    stationId: 
    requestedAction: 
    linkNote: 
    clues: []
    inspectables:
    - id: sender
      field: 0
      match: 
      label: Sender
      finding: Sam is the organiser of the clean-up you joined (see your case notes).
      linkAddress: 
      clueId: known
      part: 
    - id: group
      field: 3
      match: Hi everyone
      label: Greeting
      finding: It's written to the whole team, like a normal group update.
      linkAddress: 
      clueId: known
      part: 
    - id: details
      field: 3
      match: we'll meet at the park entrance at 9:00 on Saturday
      label: The details
      finding: The time and place of the event you signed up for.
      linkAddress: 
      clueId: expected
      part: 
    - id: bring
      field: 3
      match: Bring gloves and water
      label: What it asks
      finding: Harmless, normal instructions. It asks for no money, password or code,
        and has no link.
      linkAddress: 
      clueId: noask
      part: 
    evidence:
    - id: known
      title: From someone you know
      whyItMatters: Sam is the organiser of the clean-up you joined.
      supportsVerdict: 1
    - id: expected
      title: You were expecting it
      whyItMatters: It's about the event you signed up for.
      supportsVerdict: 1
    - id: noask
      title: Asks for nothing secret
      whyItMatters: No link, money, password or code is requested.
      supportsVerdict: 1
    consequence:
      kind: 0
      alertTitle: 
      alertBody: 
      overlookedClue: 
      followUp: 0
      recheckDetails: []
    choices: []
    correctChoice: 0
    feedback: Legitimate! It's from the organiser you know and only shares the meeting
      details.
    curriculumRef: "Information Assurance in Security 1 (BIT1101) \u2014 Week 16:
      Information Security Best Practices (user awareness)"
    hint: Who is Sam? Check your case notes, then look at what the email asks you
      to do.
    activity:
      kind: 0
      title: 
      instruction: 
      items: []
      minClues: 1
      outcomes: []
  inboxExtras: []
  caseFiles:
  - title: Case Notes
    body: "\u2022 You have not ordered anything this month.\n\u2022 You reserved
      a book at Riverside Public Library on Monday.\n\u2022 You signed up for Saturday's
      park clean-up. Sam is the volunteer team's organiser."
  - title: How This Room Works
    body: '1. 4 questions arrive one at a time, in a new order each attempt.


      2.
      Case questions: pick the safest, most accurate answer (A-D).


      3. Messages
      and web pages: choose SCAM or LEGITIMATE.


      4. Not sure? Press HINT to
      see what to look at. After each answer you''ll see why it was right or wrong.


      Goal:
      score 230+ to unlock the next room.'
  firstMessageDelay: 8
  delayBetweenMessages: {x: 10, y: 20}
  minimumActivityDelay: 4
  scoring:
    basePoints: 100
    speedBonus: 0
    fastWindow: 0.35
    wrongPenalty: 10
    recoveryPoints: 25
    baseReadingSeconds: 25
    secondsPerWord: 0.6
    secondsPerDetail: 4
    minReadingSeconds: 45
    maxReadingSeconds: 150
    caseExtraSeconds: 60
    overtimeStepSeconds: 15
    overtimePenaltyPerStep: 0
    maxTimePenalty: 0
    minCorrectPoints: 80
  oneStarScore: 140
  twoStarScore: 230
  threeStarScore: 400
  minScoreToUnlockNext: 230
  nextLevelId: level_2
  nextSceneName: Room2_InvestigationOffice
  lessons:
  - 'Spot a fake delivery text: unexpected, rushed, a small fee and a strange link.'
  - Name phishing and spot a fake look-alike address.
  - 'Recognise a real notice: it matches something you did, gives you time and asks
    for nothing secret.'
  - 'Know that not every message is a scam: a real one from someone you know just
    shares details.'
  learningSummary: 
  performanceHigh: 
  performanceModerate: 
  performanceLow: 
  tutorial: 1
  tutorialFirstQuestion: E03
