    link: 
    correctVerdict: 0
    scenarioContext: 
    explanation: 
    trigger: 0
    readingSeconds: 0
    stationId: 
    requestedAction: 
    linkNote: 
    clues: []
    inspectables: []
    evidence: []
    consequence:
      kind: 0
      alertTitle: 
      alertBody: 
      overlookedClue: 
      followUp: 0
      recheckDetails: []
    choices: []
    correctChoice: 0
    feedback: 
    curriculumRef: 
    hint: 
  - id: old_receipt
    channel: 1
    sender: Example Delivery
    senderDetail: 
    subject: Receipt for your desk lamp order
    body: Thank you for your order of 1 x desk lamp. You can track this order in
      the official Example Delivery app.
    link: 
    correctVerdict: 0
    scenarioContext: 
    explanation: 
    trigger: 0
    readingSeconds: 0
    stationId: 
    requestedAction: 
    linkNote: 
    clues: []
    inspectables: []
    evidence: []
    consequence:
      kind: 0
      alertTitle: 
      alertBody: 
      overlookedClue: 
