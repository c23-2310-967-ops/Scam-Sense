%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 147873241f4f7964690daffb230f2761, type: 3}
  m_Name: Level1_TheFirstCase
  m_EditorClassIdentifier: 
  levelId: level_1
  levelNumber: 1
  displayName: The First Case
  sceneName: Game
  description: "Your first day on the case. Texts and emails arrive while you explore
    the house \u2014 decide which are scams."
  previewImage: {fileID: 21300000, guid: 3c2461ec3d7cb3f4195d1800bbe3a169, type: 3}
  briefingTitle: WELCOME, INVESTIGATOR
  briefingText: 'You just joined the Cybercrime Investigation Unit. Scammers send
    fake texts, emails and posts to steal money, passwords and personal details,
    and your job is to catch them.


    This first room is your training case. A
    guide will show you how to investigate, use hints and answer. Six questions are
    waiting, and they arrive in a different order every time you play.'
  caseNotes:
  - You have not ordered anything this month.
  objectives:
  - Follow the guide on your first question.
  - Answer all six questions in this room.
  - Score 380 or more to unlock the next room.
  messages:
  - id: E01
    channel: 5
    sender: Case Review
    senderDetail: 
    subject: Multiple Choice
    body: Ana typed her student login into a fake "school portal" page. The scammer
      can now read her grades, messages and personal details. <b>Which part of the
      CIA Triad was broken?</b>
    link: 
    correctVerdict: 0
    scenarioContext: 
    explanation: Confidentiality means only authorized people can see information.
      The scammer was never authorized, so confidentiality is broken. Integrity would
      be broken if the scammer <i>changed</i> her data, and availability if she were
      <i>locked out</i>. Being tricked into giving the password away does not make
      the access authorized.
    trigger: 0
    readingSeconds: 0
    stationId: 
    requestedAction: 
    linkNote: 
    clues: []
    inspectables:
    - id: page
      field: 3
      match: fake "school portal" page
      label: The page
      finding: It only looks like the school portal. Whatever Ana typed went straight
        to the scammer.
      linkAddress: 
      clueId: fake
    - id: access
      field: 3
      match: read her grades, messages and personal details
      label: What the scammer can do
      finding: The scammer can now look at Ana's private information. Was anything
        changed or locked - or only seen?
      linkAddress: 
      clueId: seen
    evidence:
    - id: fake
      title: Fake login page
      whyItMatters: Fake pages copy real ones to collect what you type.
      supportsVerdict: 1
    - id: seen
      title: Private details exposed
      whyItMatters: Someone who isn't allowed can now read Ana's information.
      supportsVerdict: 1
    consequence:
      kind: 4
      alertTitle: 
      alertBody: 
      overlookedClue: 
      followUp: 1
      recheckDetails: []
    choices:
    - Availability
    - Integrity
    - Confidentiality
    - None, because she typed it in herself
    correctChoice: 2
    feedback: 'Correct. A stolen password breaks <b>confidentiality</b>: someone
      who shouldn''t see your data now can.'
    curriculumRef: "Information Assurance in Security 1 (BIT1101) \u2014 Week 3:
      Fundamentals of Information Security (CIA Triad)"
    hint: 'Think about what happened to Ana''s information: was it changed, locked
      away, or seen by someone who shouldn''t see it?'
  - id: E02
    channel: 0
    sender: +63 917 555 0142
    senderDetail: 
    subject: 
    body: "SwiftParcel: Your package is ON HOLD due to an incomplete address. Pay
      the \u20B129 redelivery fee within 12 hours or it will be returned:"
    link: http://swiftparcel-redeliver.example/pay
    correctVerdict: 0
    scenarioContext: You have not ordered anything this month.
    explanation: 'You are not expecting a package. It comes from a regular mobile
      number, sets a 12-hour deadline, and links to a domain that isn''t the courier''s.
      The small fee is bait: the real goal is your card or e-wallet details. Couriers
      don''t collect fees through random text links.'
    trigger: 3
    readingSeconds: 0
    stationId: 
    requestedAction: 
    linkNote: 
    clues: []
    inspectables:
    - id: sender
      field: 0
      match: 
      label: Sender
      finding: An ordinary mobile number, not a named courier. Real delivery companies
        text from their own name or a short code.
      linkAddress: 
      clueId: number
    - id: claim
      field: 3
      match: Your package is ON HOLD
      label: The claim
      finding: Your case notes say you haven't ordered anything this month - so which
        package?
      linkAddress: 
      clueId: noorder
    - id: fee
      field: 3
      match: "Pay the \u20B129 redelivery fee"
      label: The request
      finding: 'A small fee is bait: the real goal is your card or e-wallet details.'
      linkAddress: 
      clueId: fee
    - id: deadline
      field: 3
      match: within 12 hours
      label: Deadline
      finding: A short deadline pushes you to act before you think.
      linkAddress: 
      clueId: urgent
    - id: link
      field: 4
      match: 
      label: Link
      finding: swiftparcel-redeliver.example is not an official courier site, and
        it starts with http (not secure).
      linkAddress: http://swiftparcel-redeliver.example/pay
      clueId: link
    evidence:
    - id: number
      title: Ordinary mobile number
      whyItMatters: Couriers don't text from random mobile numbers.
      supportsVerdict: 1
    - id: noorder
      title: No order to deliver
      whyItMatters: You haven't ordered anything, so there is no real package.
      supportsVerdict: 1
    - id: fee
      title: Asks for a payment
      whyItMatters: Small fees are used to steal card and e-wallet details.
      supportsVerdict: 1
    - id: urgent
      title: Pressure to act fast
      whyItMatters: Scams rush you so you don't stop to check.
      supportsVerdict: 1
    - id: link
      title: Unofficial, insecure link
      whyItMatters: The link isn't the courier's site and isn't secure.
      supportsVerdict: 1
    consequence:
      kind: 0
      alertTitle: 
      alertBody: 
      overlookedClue: 
      followUp: 0
      recheckDetails: []
    choices: []
    correctChoice: 0
    feedback: "Scam. No order, a small 'fee' and a 12-hour deadline. They want your
      payment details, not \u20B129."
    curriculumRef: "Information Assurance in Security 1 (BIT1101) \u2014 Week 16:
      Information Security Best Practices (user awareness)"
    hint: 'Compare the text with your case notes: were you expecting a package? Then
      check who sent it and where the link goes.'
  - id: E03
    channel: 5
    sender: Case Review
    senderDetail: 
    subject: Identify the Threat
    body: '<b>Email from:</b> Campus IT Helpdesk <noparse><</noparse>helpdesk@uphs1-binan.example<noparse>></noparse>

      <b>Subject:</b>
      Mailbox 98% full: verify now

      "Your school mailbox will be DELETED in
      24 hours. Click below and sign in to verify your account." <b>What kind of
      threat is this?</b>'
    link: 
    correctVerdict: 0
    scenarioContext: 
    explanation: 'It pretends to be a trusted sender, creates fear with "deleted
      in 24 hours", and asks you to sign in through a link. That combination is phishing.
      The domain is a lookalike: <b>uphs1</b> with the number 1 in place of the letter
      <b>l</b>. Real storage warnings don''t need you to "verify" your password through
      an email link.'
    trigger: 0
    readingSeconds: 0
    stationId: 
    requestedAction: 
    linkNote: 
    clues: []
    inspectables:
    - id: address
      field: 3
      match: helpdesk@uphs1-binan.example
      label: Sender address
      finding: 'Look closely: uphs1 uses the number 1 instead of the letter l. It''s
        a lookalike of the school''s real domain.'
      linkAddress: 
      clueId: lookalike
    - id: subject
      field: 3
      match: Mailbox 98% full
      label: Subject
      finding: Full mailboxes really happen. On its own this isn't a warning sign
        - look at what the email asks you to do.
      linkAddress: 
      clueId: 
    - id: deadline
      field: 3
      match: DELETED in 24 hours
      label: Threat
      finding: A scary deadline pushes you to act fast without checking.
      linkAddress: 
      clueId: urgent
    - id: request
      field: 3
      match: sign in to verify your account
      label: What it asks
      finding: It wants your password through a link. Real IT staff never ask you
        to 'verify' your password by email.
      linkAddress: 
      clueId: creds
    evidence:
    - id: lookalike
      title: Lookalike sender domain
      whyItMatters: uphs1 is not uphsl - a fake address made to look real.
      supportsVerdict: 1
    - id: urgent
      title: Scary deadline
      whyItMatters: Threats and short deadlines are pressure tactics.
      supportsVerdict: 1
    - id: creds
      title: Asks you to sign in through a link
      whyItMatters: That's how fake pages collect passwords.
      supportsVerdict: 1
    consequence:
      kind: 4
      alertTitle: 
      alertBody: 
      overlookedClue: 
      followUp: 1
      recheckDetails: []
    choices:
    - Phishing
    - Ransomware
    - Denial-of-service attack
    - A normal storage warning
    correctChoice: 0
    feedback: 'Phishing. Look closely: <b>uphs1</b>, not uphsl. A fake sender plus
      a fake deadline plus ''sign in here'' means phishing.'
    curriculumRef: "Computer Security (BIT1225) \u2014 Introduction to Computer Security:
      \"types of security threats\u2026 in both personal and organizational contexts\""
    hint: Check the sender's address letter by letter, then ask yourself what the
      email wants you to do.
  - id: E04
    channel: 5
    sender: Case Review
    senderDetail: 
    subject: What Should You Do?
    body: 'A caller says: "This is ExampleBank''s fraud department. Someone is using
      your card right now. We just sent you a 6-digit code. Read it to me so we can
      block the transaction."'
    link: 
    correctVerdict: 0
    scenarioContext: 
    explanation: A one-time code (OTP) proves that <i>you</i> are approving something.
      Whoever has it can approve a login or payment as you, so the caller is probably
      the one making the transaction. A real bank never asks you to read an OTP aloud.
      Calling back on a number you already trust is the safe way to check.
    trigger: 0
    readingSeconds: 0
    stationId: 
    requestedAction: 
    linkNote: 
    clues: []
    inspectables:
    - id: claim
      field: 3
      match: This is ExampleBank's fraud department
      label: Who they say they are
      finding: Anyone can claim to be your bank on the phone. You didn't call them
        - they called you.
      linkAddress: 
      clueId: claim
    - id: urgent
      field: 3
      match: right now
      label: Pressure
      finding: Creating panic stops you from thinking clearly.
      linkAddress: 
      clueId: urgent
    - id: otp
      field: 3
      match: Read it to me
      label: The request
      finding: That code is your one-time password (OTP). Whoever has it can approve
        logins and payments as you.
      linkAddress: 
      clueId: otp
    evidence:
    - id: claim
      title: Unverified caller
      whyItMatters: A caller's name or claim proves nothing.
      supportsVerdict: 1
    - id: urgent
      title: Panic and urgency
      whyItMatters: Urgency is used to stop you from checking.
      supportsVerdict: 1
    - id: otp
      title: Asks for your OTP
      whyItMatters: No real bank ever asks you to read out a one-time code.
      supportsVerdict: 1
    consequence:
      kind: 4
      alertTitle: 
      alertBody: 
      overlookedClue: 
      followUp: 1
      recheckDetails: []
    choices:
    - Read the code quickly to stop the fraud
    - Give only the first three digits
    - Ask them to email you instead
    - Hang up and call the number on the back of your card or in the official app
    correctChoice: 3
    feedback: Hang up. <b>No real bank asks for your OTP.</b> Call back using the
      number on your card.
    curriculumRef: "Computer Security (BIT1225) \u2014 Authentication and Access
      Control"
    hint: Who should ever see your one-time code? And how could you check that the
      caller is really your bank?
  - id: E05
    channel: 5
    sender: Case Review
    senderDetail: 
    subject: Scenario-Based
    body: 'A stranger in a gaming chat sends you <b>FreeSkins_Generator.exe</b> and
      says: "Turn off your antivirus first. It gives a false alarm on this tool."'
    link: 
    correctVerdict: 0
    scenarioContext: 
    explanation: 'Asking you to turn off your antivirus is a major warning sign:
      the file is built to get past it. Fake "generators" are a common way to spread
      trojans and information stealers, which take saved passwords and logged-in
      sessions. Scanning afterwards is too late, and sending it to a friend puts
      them at risk.'
    trigger: 0
    readingSeconds: 0
    stationId: 
    requestedAction: 
    linkNote: 
    clues: []
    inspectables:
    - id: stranger
      field: 3
      match: A stranger in a gaming chat
      label: Sender
      finding: You don't know this person, and the offer came out of nowhere.
      linkAddress: 
      clueId: stranger
    - id: file
      field: 3
      match: FreeSkins_Generator.exe
      label: The file
      finding: .exe files are programs that run on your computer. Free 'generators'
        are a common way to spread malware.
      linkAddress: 
      clueId: exe
    - id: av
      field: 3
      match: Turn off your antivirus first
      label: The request
      finding: A real tool never needs your protection switched off. Malware does.
      linkAddress: 
      clueId: disable
    evidence:
    - id: stranger
      title: Unknown sender
      whyItMatters: Files from strangers can't be trusted.
      supportsVerdict: 1
    - id: exe
      title: A program file
      whyItMatters: Running an .exe gives it control of your computer.
      supportsVerdict: 1
    - id: disable
      title: Asks you to disable antivirus
      whyItMatters: That request exists to get malware past your protection.
      supportsVerdict: 1
    consequence:
      kind: 4
      alertTitle: 
      alertBody: 
      overlookedClue: 
      followUp: 1
      recheckDetails: []
    choices:
    - Turn off the antivirus just for a minute and run it
    - Run it, then scan your PC afterwards
    - Don't download it, and block or report the sender
    - Send it to a friend to test first
    correctChoice: 2
    feedback: Don't run it. Anyone who asks you to switch off your antivirus is trying
      to get past it.
    curriculumRef: "Computer Security (BIT1225) \u2014 Malware and Threats: \"preventing,
      detecting, and removing malware, including\u2026 anti-malware tools\""
    hint: Why would a safe program need your antivirus switched off?
  - id: E06
    channel: 2
    sender: Viral post
    senderDetail: 
    subject: FIND YOUR STAR NAME
    body: Comment your first pet's name + the street you grew up on + your birth
      month!
    link: 
    correctVerdict: 0
    scenarioContext: Is this harmless fun or a scam? LEGITIMATE = harmless fun, SCAM
      = data harvesting.
    explanation: Pet names, childhood streets and birth months are common answers
      to account security questions. Posting them publicly gives scammers what they
      need to reset your passwords or make an impersonation more convincing. The
      "game" is how they collect the answers.
    trigger: 2
    readingSeconds: 0
    stationId: 
    requestedAction: 
    linkNote: 
    clues: []
    inspectables:
    - id: sender
      field: 0
      match: 
      label: Who posted it
      finding: A viral post from someone you don't know. It's made to be shared widely.
      linkAddress: 
      clueId: 
    - id: comment
      field: 3
      match: Comment your
      label: Where you answer
      finding: Comments are public. Anyone - including scammers - can read them.
      linkAddress: 
      clueId: public
    - id: pet
      field: 3
      match: first pet's name
      label: It asks for
      finding: A very common answer to account security questions.
      linkAddress: 
      clueId: secq
    - id: street
      field: 3
      match: street you grew up on
      label: It asks for
      finding: Another classic security-question answer.
      linkAddress: 
      clueId: secq
    - id: month
      field: 3
      match: birth month
      label: It asks for
      finding: Part of your birthday, which is often used to confirm who you are.
      linkAddress: 
      clueId: personal
    evidence:
    - id: public
      title: Public answers
      whyItMatters: Anything posted in comments is visible to everyone.
      supportsVerdict: 1
    - id: secq
      title: Security-question answers
      whyItMatters: These answers are used to reset passwords.
      supportsVerdict: 1
    - id: personal
      title: Personal details
      whyItMatters: Birthdays help scammers pretend to be you.
      supportsVerdict: 1
    consequence:
      kind: 0
      alertTitle: 
      alertBody: 
      overlookedClue: 
      followUp: 0
      recheckDetails: []
    choices: []
    correctChoice: 0
    feedback: Data harvesting. Those are classic <b>security-question answers</b>.
      Don't post them.
    curriculumRef: "Social and Professional Issues (BIT2105) \u2014 Weeks 10\u201311:
      Ethics for IT Users (\"responsible use of\u2026 social media\")"
    hint: Look at the three things the post asks for. Where else are those exact
      answers used?
  inboxExtras:
  - id: old_library
    channel: 1
    sender: Riverside Public Library
    senderDetail: 
    subject: Your reserved book is ready for pickup
    body: The book you reserved is now available at the front desk. It will be held
