  achievements:
  - id: first_case
    title: First Case Solved
    description: Solve your first case.
  - id: flawless
    title: Flawless Analysis
    description: Identify every message in a case correctly.
  - id: rapid
    title: Rapid Response
    description: Answer every message in a case correctly and at full speed.
  - id: evidence_expert
    title: Evidence Expert
    description: Inspect all the required evidence before closing a case.
  - id: consistent
    title: Consistent Analyst
    description: Reach 80% accuracy in three different cases.
  - id: promotion_day
    title: Promotion Day
    description: Earn a new career rank.
  - id: forensics
    title: Master of Digital Forensics
    description: Solve a final multi-evidence case correctly.
  - id: all_cases
    title: Case Load Cleared
    description: Solve every case in the game.
  - id: elite
    title: Elite Investigator
    description: Reach the rank of Elite Cybersecurity Agent.
  - id: master
    title: Master Digital Investigator
    description: Reach the highest career rank.
